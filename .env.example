# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Auth.js (sign in with GitHub, via the GitHub App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Living Brain (server-side only)
LIVING_BRAIN_API_KEY=
LIVING_BRAIN_BRAIN_ID=

# BSC testnet minter wallet (server-side only, dedicated testnet wallet)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
MINTER_PRIVATE_KEY=
BADGE_CONTRACT_ADDRESS=

# Admin accounts: GitHub logins (comma separated) allowed to create events and show the check-in QR
ADMIN_GITHUB_LOGINS=

# Optional: your GitHub App slug (github.com/apps/<slug>), for the "give access to private repositories" link
GITHUB_APP_SLUG=
